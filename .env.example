# ---------------------------------------------------------------------------
# Environment template
# Copy to .env.local and fill in values. Never commit real secrets.
# Variables are grouped by the phase that first uses them.
# ---------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SEO (Phase 14)
# Canonical public origin. Every canonical URL, hreflang target, OG image
# URL, sitemap entry and robots reference derives from this one value.
# Set it to the production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Phase 1)
# Postgres 16+ connection string.
# Option A: bundled Docker Compose -> postgresql://grooma:grooma@localhost:5432/grooma
# Option B: your own local Postgres instance.
DATABASE_URL=postgresql://grooma:grooma@localhost:5432/grooma

# Tenancy and locale (Phase 1)
# Slug of the shop this deployment serves.
DEFAULT_SHOP_SLUG=demo-classic-barbershop
# Fallback locale when a visitor has no preference. Supported: en, ne
DEFAULT_LOCALE=en

# Authentication (Phase 2, Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Transactional email (Phase 12, Resend)
RESEND_API_KEY=
EMAIL_FROM="Grooma <bookings@example.com>"
